# Copy this file to .devcontainer/.env for a public-registry setup (no JFrog).
# For BAC devs behind Zscaler/JFrog, copy .env.jfrog instead.
#
# .env is gitignored — project-specific knobs live here.
# Secrets (JFROG_TOKEN) live in ~/.env (sourced by ~/.zshenv) — NOT here.
# docker-compose picks them up from the shell env automatically.

USE_JFROG=false

# Devcontainer base image — public Microsoft registry.
BASE_IMAGE=mcr.microsoft.com/devcontainers/base:bullseye

# AEM preview target for `aem up` (postAttachCommand).
AEM_PARAMS=--url https://main--shop-summit--blueacorninc.aem.live
