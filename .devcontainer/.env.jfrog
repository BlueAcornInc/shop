# BAC JFrog-routed setup. Copy this file to .devcontainer/.env and fill in
# your JFROG_TOKEN.
#
# Get your JFrog identity token from:
#   https://groupinfosys.jfrog.io/ui/user_profile  →  "Generate Identity Token"
#
# .env is gitignored — keep credentials there, never commit them.

# Route all registries through groupinfosys.jfrog.io.
USE_JFROG=true
JFROG_HOST=groupinfosys.jfrog.io
JFROG_USER=your.name@groupinfosys.com
JFROG_TOKEN=REPLACE_ME_JFROG_TOKEN

# Devcontainer base image — JFrog mirror of mcr.microsoft.com.
BASE_IMAGE=groupinfosys.jfrog.io/bls-mcr-microsoft-remote/devcontainers/base:bullseye

# AEM preview target for `aem up` (postAttachCommand).
AEM_PARAMS=--url https://main--shop-summit--blueacorninc.aem.live
