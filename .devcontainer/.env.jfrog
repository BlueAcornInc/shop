# BAC JFrog-routed setup. Copy this file to .devcontainer/.env.
#
# Secrets (JFROG_TOKEN, JFROG_USER) live in ~/.env sourced by ~/.zshenv:
#
#   # in ~/.zshenv
#   [ -f ~/.env ] && set -a && . ~/.env && set +a
#
# Generate a JFrog identity token at:
#   https://groupinfosys.jfrog.io/ui/user_profile  →  "Generate Identity Token"
#
# docker-compose resolves ${JFROG_TOKEN} / ${JFROG_USER} from the shell env
# first, so you don't set them here — only project-specific knobs.

USE_JFROG=true
JFROG_HOST=groupinfosys.jfrog.io

# Devcontainer base image — JFrog mirror of the javascript-node image
# (Node/npm/nvm preinstalled as the vscode user).
BASE_IMAGE=groupinfosys.jfrog.io/bls-mcr-microsoft-remote/devcontainers/javascript-node:20-bullseye

# AEM preview target for `aem up` (postAttachCommand).
AEM_PARAMS=--url https://main--shop-summit--blueacorninc.aem.live

# Zscaler CA bundle from the host. Symlink the system bundle in so the
# Dockerfile's COPY ./zscaler.cr[t] picks it up:
#
#   ln -sf ~/.ssl/combined-ca.pem .devcontainer/zscaler.crt
#
# .devcontainer/zscaler.crt is gitignored.
