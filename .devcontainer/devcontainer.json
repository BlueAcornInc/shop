{
	"name": "blueacornici.shop",

	"dockerComposeFile": "docker-compose.yml",
	"service": "app",

	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"shutdownAction": "stopCompose",

	// setup.sh runs on every attach so you can see its output in the terminal
	// (and re-running is cheap — every step is idempotent). It ends with
	// `aem up` so the storefront launches in the same command.
	"postAttachCommand": "bash .devcontainer/setup.sh && npx aem up $AEM_PARAMS",

	"forwardPorts": [3000],
	"customizations": {
		"vscode": {
			"extensions": [
				"ryanluker.vscode-coverage-gutters"
			]
		}
	},
	// "features": {
	// 	"ghcr.io/christophermacgown/devcontainer-features/direnv:1": {}
	// },

	"remoteEnv": {
		"AEM_PARAMS": "--url https://main--shop-summit--blueacorninc.aem.live"
	},

	"portsAttributes": {
		"3000": {
		  "label": "Adobe Commerce Storefront (HTTP)"
		}



}
